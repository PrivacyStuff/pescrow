# Pooled Neon connection string for the waitlist database.
DATABASE_URL=
# HMAC salt for short-lived network-address hashes. At least 32 characters.
WAITLIST_IP_SALT=
# Server-only Helius JSON-RPC URL, including the api-key query. Empty falls back to HELIUS_API_KEY, then the Solana CLI config.
HELIUS_RPC_URL=
# Devnet faucet. Production serves it only when FAUCET_ENABLED=1.
FAUCET_ENABLED=
# Dedicated faucet hot wallet, never the admin or mint-authority key. 64-byte JSON array as written by solana-keygen.
# Mark it Sensitive in Vercel. The wallet must hold devnet SOL and the test USDC it sends.
FAUCET_SECRET_KEY=
# Local alternative to FAUCET_SECRET_KEY: path to the same keypair file.
FAUCET_KEYPAIR_PATH=
